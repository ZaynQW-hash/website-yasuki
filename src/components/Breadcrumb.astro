---
export interface BreadcrumbItem {
  label: string;
  href?: string;
}
const { items } = Astro.props as { items: BreadcrumbItem[] };
---
<nav class="max-w-6xl mx-auto px-6 pt-3 text-xs md:text-sm" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-1 text-blue-200">
    {items.map((item, i) => (
      <li class="flex items-center gap-1">
        {i > 0 && <span class="text-blue-400">/</span>}
        {item.href ? (
          <a href={item.href} class="hover:text-amber-400 transition">{item.label}</a>
        ) : (
          <span class="text-amber-400 font-medium">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
