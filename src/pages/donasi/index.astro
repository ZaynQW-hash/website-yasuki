---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { env } from "cloudflare:workers";

interface ProgramRow {
  nama: string;
  slug: string;
  kategori: string;
  headline: string;
  foto: string | null;
  href_custom: string | null;
  href_external: number;
  target: number | null;
  terkumpul: number | null;
  tampilkan_progress: number;
}

const db = env.yasuki_db;
const { results: programRows } = await db
  .prepare(
    "SELECT nama, slug, kategori, headline, foto, href_custom, href_external, target, terkumpul, tampilkan_progress FROM program WHERE status = 1 ORDER BY urutan ASC, id ASC",
  )
  .all<ProgramRow>();

const programCards = programRows.map((p) => {
  const showProgress = !!p.tampilkan_progress && !!p.target && p.target > 0 && p.terkumpul !== null;
  return {
    nama: p.nama,
    kategori: p.kategori,
    headline: p.headline,
    foto: p.foto,
    href: p.href_custom || `/program#${p.slug}`,
    external: !!p.href_custom && !!p.href_external,
    terkumpul: showProgress ? `Rp${p.terkumpul!.toLocaleString("id-ID")}` : null,
    target: p.target,
    persen: showProgress ? Math.min(100, Math.round((p.terkumpul! / p.target!) * 100)) : null,
  };
});
---
<Layout title="Donasi — Yasuki">
  <section class="relative pt-24 pb-16 px-6 text-center overflow-hidden">
    <img src="/images/program/santunan-lansia.jpg" alt="Donasi Yasuki" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-blue-950/85"></div>
    <Breadcrumb items={[{ label: "Beranda", href: "/" }, { label: "Donasi" }]} />
    <div class="relative z-10 mt-6">
      <p class="text-amber-400 font-medium text-sm uppercase tracking-wide mb-2">Berbagi Kebaikan</p>
      <h1 class="text-3xl md:text-5xl font-bold text-white mb-4">Donasi Sekarang</h1>
      <p class="text-blue-100 max-w-xl mx-auto">
        Setiap donasi, besar maupun kecil, membawa manfaat nyata bagi yang membutuhkan.
      </p>
    </div>
  </section>

  <section id="form" class="px-6 py-16 bg-white scroll-mt-20">
    <div class="max-w-md mx-auto">
      <div class="flex items-center justify-center gap-2 mb-6 text-xs text-slate-500 flex-wrap">
        <span class="bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full font-medium">✓ Terdaftar resmi Kemenkumham RI</span>
        <span class="bg-amber-50 text-amber-700 px-3 py-1 rounded-full font-medium">10.000+ paket disalurkan</span>
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
        <div id="form-donasi-wrapper">
          <p class="text-slate-500 text-sm mb-4">
            Isi data di bawah, lalu transfer sesuai instruksi yang muncul setelah kamu klik "Kirim".
          </p>
          <form id="form-donasi" class="flex flex-col gap-4">
            <div>
              <label class="text-slate-700 text-sm mb-1 block">Nama</label>
              <input type="text" name="nama" required class="w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-blue-950" placeholder="Nama lengkap" />
            </div>
            <div>
              <label class="text-slate-700 text-sm mb-1 block">Nomor WhatsApp</label>
              <input type="text" name="whatsapp" required class="w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-blue-950" placeholder="08xx-xxxx-xxxx" />
            </div>
            <div>
              <label class="text-slate-700 text-sm mb-1 block">Program</label>
              <select name="program" required class="w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-blue-950">
                {programCards.map((p) => <option value={p.nama}>{p.nama}</option>)}
                <option value="Donasi Umum">Donasi Umum (tidak terikat program)</option>
              </select>
            </div>
            <div>
              <label class="text-slate-700 text-sm mb-1 block">Nominal</label>
              <div class="grid grid-cols-4 gap-2 mb-2">
                {[10000, 50000, 100000, 200000, 500000].map((n) => (
                  <button type="button" data-nominal={n} class="nominal-preset bg-white border border-slate-300 rounded-lg py-2 text-xs font-medium text-blue-950 hover:bg-blue-50 hover:border-blue-900 transition">
                    {n >= 1000000 ? `${n / 1000000}jt` : `${n / 1000}rb`}
                  </button>
                ))}
              </div>
              <input type="number" name="nominal" id="input-nominal" required min="1000" class="w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-blue-950" placeholder="Atau isi nominal lain (Rp)" />
            </div>
            <div>
              <label class="text-slate-700 text-sm mb-1 block">Pesan (opsional)</label>
              <textarea name="pesan" rows="2" class="w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-blue-950"></textarea>
            </div>
            <label class="flex items-center gap-2 text-sm text-slate-600">
              <input type="checkbox" name="tampilkan_nama" class="rounded" />
              Tampilkan nama saya di daftar donatur publik
            </label>
            <button type="submit" id="btn-submit" class="bg-amber-400 text-slate-900 font-semibold py-3 rounded-lg hover:bg-amber-300 transition">
              Kirim
            </button>
            <p id="form-error" class="text-red-600 text-sm hidden"></p>
          </form>
        </div>

        <!-- Ditampilkan menggantikan form setelah submit berhasil. Detail lengkap (QRIS/rekening) ada di modal popup & kartu bawah. -->
        <div id="sukses-ringkas" class="hidden text-center py-4">
          <div class="text-3xl mb-2">✅</div>
          <h3 class="text-blue-950 font-bold text-lg mb-2">Terima kasih!</h3>
          <p class="text-slate-500 text-sm mb-4">Instruksi pembayaran (QRIS & rekening) sudah dikirim.</p>
          <a href="#hasil-donasi-bawah" class="inline-block text-blue-800 font-medium text-sm hover:underline">
            ↓ Lihat lagi instruksi pembayaran
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Kartu Program Donasi -->
  <section class="px-6 py-16 bg-blue-50 bg-[radial-gradient(circle,rgba(30,58,138,0.12)_1px,transparent_1px)] bg-[length:22px_22px]">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl font-bold text-blue-950 mb-2">Pilih Program yang Ingin Didukung</h2>
        <p class="text-slate-500">Klik salah satu untuk lihat detail dan progres terkininya</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
        {programCards.map((p) => (
          <a
            href={p.href}
            target={p.external ? "_blank" : undefined}
            class="group bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition flex flex-col"
          >
            <div class="relative h-32 bg-slate-100">
              {p.foto && (
                <img src={p.foto} alt={p.nama} class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-500" />
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-blue-950/90 via-blue-950/20 to-transparent" />
              <p class="absolute bottom-2 left-2 right-2 text-white text-xs font-bold leading-tight">{p.headline}</p>
            </div>
            <div class="p-3 flex flex-col flex-1">
              <span class="inline-block bg-amber-50 text-amber-700 text-[10px] font-medium px-2 py-0.5 rounded-full mb-2 w-fit">
                {p.kategori}
              </span>
              <p class="text-blue-950 text-sm font-semibold leading-snug mb-2 flex-1">{p.nama}</p>
              {p.terkumpul ? (
                <div>
                  <div class="w-full bg-slate-200 rounded-full h-1.5 mb-1.5">
                    <div class="bg-amber-400 h-1.5 rounded-full" style={`width: ${p.persen}%`}></div>
                  </div>
                  <p class="text-slate-700 text-[11px]">Terkumpul <span class="font-semibold">{p.terkumpul}</span></p>
                </div>
              ) : (
                <p class="text-amber-600 text-[11px] font-medium">Lihat Program →</p>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Kartu hasil donasi versi "sudah ditutup dari modal" - muncul di bawah program, setelah modal ditutup -->
  <section id="hasil-donasi-bawah" class="hidden px-6 pb-16 bg-white scroll-mt-20">
    <div class="max-w-md mx-auto bg-slate-50 border border-slate-200 rounded-xl p-6 fade-slide-in">
      <div id="bawah-konten-hasil"></div>
    </div>
  </section>

  <!-- Modal popup hasil donasi -->
  <div id="modal-hasil-donasi" class="hidden fixed inset-0 z-50 items-center justify-center p-4">
    <div id="modal-backdrop" class="absolute inset-0 bg-blue-950/70"></div>
    <div class="relative bg-white rounded-2xl max-w-md w-full max-h-[90vh] overflow-y-auto p-6 modal-pop">
      <button type="button" id="btn-close-modal" aria-label="Tutup" class="absolute top-3 right-3 w-8 h-8 flex items-center justify-center rounded-full text-slate-400 hover:bg-slate-100 hover:text-slate-700 text-lg leading-none">
        ✕
      </button>
      <div id="modal-konten-hasil"></div>
    </div>
  </div>

  <!-- Template isi hasil donasi (QRIS + rekening + kode referensi), di-clone ke modal & kartu bawah -->
  <template id="template-hasil-donasi">
    <div class="text-3xl mb-2 text-center">✅</div>
    <h3 class="text-blue-950 font-bold text-lg mb-4 text-center">Terima kasih! Silakan transfer ke salah satu rekening/QRIS berikut:</h3>

    <div class="bg-white rounded-lg p-4 mb-4 flex justify-center border border-slate-100">
      <img src="/images/donasi/qris.jpg" alt="QRIS Yasuki Purworejo" class="w-72 md:w-80" />
    </div>

    <div class="text-left space-y-2 mb-4">
      <button type="button" class="btn-copy w-full bg-white border border-slate-200 rounded-lg p-3 flex justify-between items-center hover:bg-blue-50 transition" data-rekening="0078-01-000553-565">
        <div>
          <p class="text-slate-500 text-xs">BRI</p>
          <p class="text-blue-950 font-semibold">0078-01-000553-565</p>
        </div>
        <span class="copy-icon text-blue-900 text-xs font-medium border border-blue-900 rounded px-2 py-1">Salin</span>
      </button>
      <button type="button" class="btn-copy w-full bg-white border border-slate-200 rounded-lg p-3 flex justify-between items-center hover:bg-blue-50 transition" data-rekening="1850002826987">
        <div>
          <p class="text-slate-500 text-xs">Mandiri</p>
          <p class="text-blue-950 font-semibold">185-00-0282698-7</p>
        </div>
        <span class="copy-icon text-blue-900 text-xs font-medium border border-blue-900 rounded px-2 py-1">Salin</span>
      </button>
      <button type="button" class="btn-copy w-full bg-white border border-slate-200 rounded-lg p-3 flex justify-between items-center hover:bg-blue-50 transition" data-rekening="7168851078">
        <div>
          <p class="text-slate-500 text-xs">BSI</p>
          <p class="text-blue-950 font-semibold">716 885 1078</p>
        </div>
        <span class="copy-icon text-blue-900 text-xs font-medium border border-blue-900 rounded px-2 py-1">Salin</span>
      </button>
      <p class="text-slate-500 text-xs text-center">a.n. Yayasan Sosial Umi Kulsum Indonesia</p>
    </div>

    <div class="border-t border-slate-200 pt-3">
      <p class="text-slate-500 text-xs">Kode referensi (opsional, cantumkan di berita transfer untuk mempercepat verifikasi):</p>
      <p class="kode-referensi-slot text-sm font-semibold text-slate-600"></p>
    </div>
  </template>

  <script>
    const presetButtons = document.querySelectorAll('.nominal-preset');
    const inputNominal = document.getElementById('input-nominal') as HTMLInputElement;

    presetButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const nominal = btn.getAttribute('data-nominal');
        inputNominal.value = nominal || '';
        presetButtons.forEach((b) => {
          b.classList.remove('bg-blue-900', 'text-white', 'border-blue-900');
          b.classList.add('bg-white', 'text-blue-950', 'border-slate-300');
        });
        btn.classList.add('bg-blue-900', 'text-white', 'border-blue-900');
        btn.classList.remove('bg-white', 'text-blue-950', 'border-slate-300');
      });
    });

    function attachCopyButtons(container: ParentNode) {
      container.querySelectorAll('.btn-copy').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const rekening = btn.getAttribute('data-rekening') || '';
          const icon = btn.querySelector('.copy-icon') as HTMLElement;
          try {
            await navigator.clipboard.writeText(rekening);
            const original = icon.textContent;
            icon.textContent = 'Tersalin!';
            icon.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');
            setTimeout(() => {
              icon.textContent = original;
              icon.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-600');
            }, 1500);
          } catch (err) {
            icon.textContent = 'Gagal';
          }
        });
      });
    }

    const templateHasil = document.getElementById('template-hasil-donasi') as HTMLTemplateElement;
    const modal = document.getElementById('modal-hasil-donasi') as HTMLDivElement;
    const modalKonten = document.getElementById('modal-konten-hasil') as HTMLDivElement;
    const btnCloseModal = document.getElementById('btn-close-modal') as HTMLButtonElement;
    const hasilBawahSection = document.getElementById('hasil-donasi-bawah') as HTMLDivElement;
    const bawahKonten = document.getElementById('bawah-konten-hasil') as HTMLDivElement;
    const suksesRingkas = document.getElementById('sukses-ringkas') as HTMLDivElement;

    let kodeReferensiTerakhir = '';

    function isiTemplate(kodeReferensi: string): DocumentFragment {
      const clone = templateHasil.content.cloneNode(true) as DocumentFragment;
      const kodeEl = clone.querySelector('.kode-referensi-slot');
      if (kodeEl) kodeEl.textContent = kodeReferensi;
      return clone;
    }

    function bukaModal(kodeReferensi: string) {
      modalKonten.innerHTML = '';
      modalKonten.appendChild(isiTemplate(kodeReferensi));
      attachCopyButtons(modalKonten);
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.classList.add('overflow-hidden');
    }

    function tutupModalDanPindahKeBawah() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.classList.remove('overflow-hidden');

      bawahKonten.innerHTML = '';
      bawahKonten.appendChild(isiTemplate(kodeReferensiTerakhir));
      attachCopyButtons(bawahKonten);
      hasilBawahSection.classList.remove('hidden');
    }

    btnCloseModal?.addEventListener('click', tutupModalDanPindahKeBawah);

    // Klik area gelap di luar kartu modal juga menutup modal
    document.getElementById('modal-backdrop')?.addEventListener('click', tutupModalDanPindahKeBawah);

    const form = document.getElementById('form-donasi') as HTMLFormElement;
    const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement;
    const formError = document.getElementById('form-error') as HTMLParagraphElement;
    const formWrapper = document.getElementById('form-donasi-wrapper') as HTMLDivElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      formError.classList.add('hidden');
      btnSubmit.disabled = true;
      btnSubmit.textContent = 'Mengirim...';

      const formData = new FormData(form);
      const payload = {
        nama: formData.get('nama'),
        whatsapp: formData.get('whatsapp'),
        program: formData.get('program'),
        nominal: formData.get('nominal'),
        pesan: formData.get('pesan'),
        tampilkan_nama: formData.get('tampilkan_nama') === 'on',
      };

      try {
        const res = await fetch('/api/donasi', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await res.json();

        if (!res.ok) {
          formError.textContent = result.error || 'Terjadi kesalahan, coba lagi.';
          formError.classList.remove('hidden');
          btnSubmit.disabled = false;
          btnSubmit.textContent = 'Kirim';
          return;
        }

        kodeReferensiTerakhir = result.kode_referensi;
        formWrapper.classList.add('hidden');
        suksesRingkas.classList.remove('hidden');
        bukaModal(kodeReferensiTerakhir);
      } catch (err) {
        formError.textContent = 'Gagal terhubung ke server. Periksa koneksi internet kamu.';
        formError.classList.remove('hidden');
        btnSubmit.disabled = false;
        btnSubmit.textContent = 'Kirim';
      }
    });
  </script>

  <style>
    @keyframes modalPop {
      from { opacity: 0; transform: scale(0.95) translateY(8px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }
    .modal-pop {
      animation: modalPop 0.25s ease-out both;
    }

    @keyframes fadeSlideIn {
      from { opacity: 0; transform: translateY(16px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .fade-slide-in {
      animation: fadeSlideIn 0.5s ease-out both;
    }
  </style>
</Layout>
