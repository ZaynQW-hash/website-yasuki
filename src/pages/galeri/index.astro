---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { env } from "cloudflare:workers";

interface GaleriRow {
  id: number;
  foto: string;
  kategori: string;
  caption: string;
}

const db = env.yasuki_db;
const { results: semuaFoto } = await db
  .prepare("SELECT id, foto, kategori, caption FROM galeri WHERE aktif = 1 ORDER BY urutan ASC")
  .all<GaleriRow>();

const kategoriList = ["Semua", ...new Set(semuaFoto.map((f) => f.kategori))];
const fotoSampulHero = semuaFoto[0]?.foto || "/images/galeri/qurban-2025-4.jpg";
---
<Layout
  title="Galeri — Yasuki"
  description="Dokumentasi kegiatan Yayasan Sosial Umi Kulsum Indonesia (Yasuki) — santunan, kegiatan anak binaan, bakti sosial, dan momen kebaikan lainnya."
>
  <section class="relative pt-24 pb-16 px-6 text-center overflow-hidden">
    <img src={fotoSampulHero} alt="Galeri Yasuki" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-blue-950/85"></div>
    <Breadcrumb items={[{ label: "Beranda", href: "/" }, { label: "Galeri" }]} />
    <div class="relative z-10 mt-6">
      <p class="text-amber-400 font-medium text-sm uppercase tracking-wide mb-2">Dokumentasi</p>
      <h1 class="text-3xl md:text-5xl font-bold text-white mb-4">Galeri Kegiatan</h1>
      <p class="text-blue-100 max-w-xl mx-auto">
        Momen-momen nyata dari lapangan — santunan, pendidikan, pembangunan, hingga aksi kemanusiaan Yasuki.
      </p>
    </div>
  </section>

  <section class="px-6 py-16 bg-white">
    <div class="max-w-6xl mx-auto">
      {
        semuaFoto.length === 0 && (
          <p class="text-center text-slate-400 py-16">Belum ada foto galeri.</p>
        )
      }

      {
        semuaFoto.length > 0 && (
          <>
            <div class="flex flex-wrap justify-center gap-2 mb-10" id="filter-bar">
              {kategoriList.map((k, i) => (
                <button
                  data-filter={k}
                  class={`filter-btn text-xs md:text-sm font-medium px-4 py-1.5 rounded-full border transition ${i === 0 ? "bg-blue-900 text-white border-blue-900" : "bg-white text-slate-600 border-slate-300 hover:border-blue-900"}`}
                >
                  {k}
                </button>
              ))}
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-4" id="galeri-grid">
              {semuaFoto.map((f) => (
                <button type="button" class="gallery-item text-left rounded-lg overflow-hidden shadow-sm bg-slate-50 group cursor-pointer" data-kategori={f.kategori}>
                  <div class="h-32 md:h-36 relative overflow-hidden">
                    <img src={f.foto} alt={f.caption} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                    <span class="absolute top-2 left-2 bg-amber-400 text-slate-900 text-[10px] font-semibold px-2 py-0.5 rounded-full">
                      {f.kategori}
                    </span>
                  </div>
                  <p class="gallery-caption text-slate-600 text-[11px] p-2 leading-snug text-center">{f.caption}</p>
                </button>
              ))}
            </div>
          </>
        )
      }
    </div>
  </section>

  <!-- CTA Penutup -->
  <section class="px-6 py-16 bg-gradient-to-br from-amber-400 to-amber-500 text-center">
    <h2 class="text-xl md:text-2xl font-bold text-slate-900 mb-3">Jadi Bagian dari Momen Berikutnya</h2>
    <p class="text-slate-800 max-w-md mx-auto mb-6">
      Dukung kegiatan Yasuki lewat donasi — sekecil apapun, akan jadi cerita baik selanjutnya.
    </p>
    <a href="/donasi" class="inline-block bg-slate-900 text-white px-8 py-3 rounded-lg font-semibold hover:bg-slate-800 transition">
      Donasi Sekarang
    </a>
  </section>

  <!-- Lightbox popup -->
  <div id="lightbox" class="hidden fixed inset-0 z-50 items-center justify-center p-4 bg-blue-950/90">
    <button type="button" id="lightbox-close" aria-label="Tutup" class="absolute top-4 right-4 text-white text-2xl w-10 h-10 flex items-center justify-center rounded-full hover:bg-white/10">
      ✕
    </button>
    <button type="button" id="lightbox-prev" aria-label="Sebelumnya" class="absolute left-2 md:left-6 text-white text-3xl w-10 h-10 flex items-center justify-center rounded-full hover:bg-white/10">
      ‹
    </button>
    <button type="button" id="lightbox-next" aria-label="Berikutnya" class="absolute right-2 md:right-6 text-white text-3xl w-10 h-10 flex items-center justify-center rounded-full hover:bg-white/10">
      ›
    </button>
    <div class="max-w-3xl w-full lightbox-pop">
      <img id="lightbox-img" src="" alt="" class="w-full max-h-[70vh] object-contain rounded-lg mx-auto" />
      <div class="text-center mt-4">
        <span id="lightbox-kategori" class="inline-block bg-amber-400 text-slate-900 text-xs font-semibold px-3 py-1 rounded-full mb-2"></span>
        <p id="lightbox-caption" class="text-white text-sm"></p>
      </div>
    </div>
  </div>
</Layout>

<style>
  @keyframes lightboxPop {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  .lightbox-pop {
    animation: lightboxPop 0.2s ease-out both;
  }
</style>

<script>
  const buttons = document.querySelectorAll('.filter-btn');
  const items = Array.from(document.querySelectorAll('.gallery-item'));

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      buttons.forEach((b) => {
        b.classList.remove('bg-blue-900', 'text-white', 'border-blue-900');
        b.classList.add('bg-white', 'text-slate-600', 'border-slate-300');
      });
      btn.classList.add('bg-blue-900', 'text-white', 'border-blue-900');
      btn.classList.remove('bg-white', 'text-slate-600', 'border-slate-300');

      items.forEach((item) => {
        const kategori = item.getAttribute('data-kategori');
        if (filter === 'Semua' || kategori === filter) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
    });
  });

  // --- Lightbox ---
  const lightbox = document.getElementById('lightbox') as HTMLDivElement;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxCaption = document.getElementById('lightbox-caption') as HTMLParagraphElement;
  const lightboxKategori = document.getElementById('lightbox-kategori') as HTMLSpanElement;
  let currentIndex = 0;

  function getVisibleItems(): HTMLElement[] {
    return items.filter((item) => !item.classList.contains('hidden')) as HTMLElement[];
  }

  function openLightbox(index: number) {
    const visible = getVisibleItems();
    if (visible.length === 0) return;
    currentIndex = ((index % visible.length) + visible.length) % visible.length;
    const item = visible[currentIndex];
    const img = item.querySelector('img') as HTMLImageElement;
    const caption = item.querySelector('.gallery-caption')?.textContent?.trim() || '';
    const kategori = item.getAttribute('data-kategori') || '';

    lightboxImg.src = img.src;
    lightboxImg.alt = img.alt;
    lightboxCaption.textContent = caption;
    lightboxKategori.textContent = kategori;

    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.classList.add('overflow-hidden');
  }

  function closeLightbox() {
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.classList.remove('overflow-hidden');
  }

  items.forEach((item) => {
    item.addEventListener('click', () => {
      const visible = getVisibleItems();
      openLightbox(visible.indexOf(item as HTMLElement));
    });
  });

  document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.getElementById('lightbox-prev')?.addEventListener('click', () => openLightbox(currentIndex - 1));
  document.getElementById('lightbox-next')?.addEventListener('click', () => openLightbox(currentIndex + 1));

  document.addEventListener('keydown', (e) => {
    if (lightbox.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') openLightbox(currentIndex - 1);
    if (e.key === 'ArrowRight') openLightbox(currentIndex + 1);
  });
</script>
