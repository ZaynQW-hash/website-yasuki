---
import AdminLayout from "../../layouts/AdminLayout.astro";

const admin = Astro.locals.admin;
---

<AdminLayout title="Dashboard Admin — Yasuki" admin={admin}>
  <div class="max-w-4xl mx-auto">
    <h1 class="text-2xl font-bold text-slate-800 mb-6">Dashboard Admin</h1>

    <div class="bg-white rounded-xl shadow-sm p-6">
      <p class="text-slate-600 mb-4">
        Halo, <strong>{admin?.nama}</strong> ({admin?.role}). Login berhasil.
      </p>
      <a href="/admin/donasi" class="inline-block bg-blue-800 hover:bg-blue-900 text-white text-sm font-medium px-4 py-2 rounded-lg">
        Kelola Donasi →
      </a>
    </div>
  </div>
</AdminLayout>
