---
import AdminLayout from "../../../layouts/AdminLayout.astro";

const admin = Astro.locals.admin;

if (admin?.role !== "superadmin") {
  return Astro.redirect("/admin");
}
---

<AdminLayout title="Tambah Admin — Yasuki" admin={admin}>
  <div class="max-w-md mx-auto">
    <h1 class="text-xl font-bold text-slate-800 mb-6">Tambah Admin</h1>

    <form id="form-admin" class="bg-white rounded-xl shadow-sm p-6 space-y-5">
      <div>
        <label for="nama" class="block text-sm font-medium text-slate-700 mb-1">Nama</label>
        <input
          type="text"
          id="nama"
          name="nama"
          required
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-700"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-slate-700 mb-1">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-700"
          placeholder="admin@yasuki.site"
        />
        <p class="text-xs text-slate-400 mt-1">Tidak harus email aktif, cukup format email valid buat login.</p>
      </div>

      <div>
        <label for="password" class="block text-sm font-medium text-slate-700 mb-1">Password</label>
        <input
          type="password"
          id="password"
          name="password"
          required
          minlength="8"
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-700"
        />
        <p class="text-xs text-slate-400 mt-1">Minimal 8 karakter. Kasih tau password ini ke admin yang bersangkutan secara langsung.</p>
      </div>

      <div>
        <label for="role" class="block text-sm font-medium text-slate-700 mb-1">Role</label>
        <select
          id="role"
          name="role"
          required
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-700"
        >
          <option value="admin">Admin (akses Donasi, Berita, Program)</option>
          <option value="superadmin">Superadmin (akses semua + kelola akun admin lain)</option>
        </select>
      </div>

      <p id="error-msg" class="text-sm text-red-600 hidden"></p>

      <div class="flex gap-3">
        <button
          type="submit"
          id="btn-submit"
          class="bg-blue-800 hover:bg-blue-900 text-white font-medium px-4 py-2 rounded-lg text-sm disabled:opacity-60"
        >
          Simpan Admin
        </button>
        <a href="/admin/pengguna" class="px-4 py-2 rounded-lg text-sm text-slate-600 hover:bg-slate-100">Batal</a>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  const form = document.getElementById("form-admin") as HTMLFormElement;
  const btnSubmit = document.getElementById("btn-submit") as HTMLButtonElement;
  const errorMsg = document.getElementById("error-msg") as HTMLParagraphElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorMsg.classList.add("hidden");
    btnSubmit.disabled = true;
    btnSubmit.textContent = "Menyimpan...";

    const formData = new FormData(form);
    const payload = {
      nama: formData.get("nama"),
      email: formData.get("email"),
      password: formData.get("password"),
      role: formData.get("role"),
    };

    try {
      const res = await fetch("/api/admin/pengguna", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = (await res.json()) as { error?: string };

      if (!res.ok) {
        errorMsg.textContent = data.error || "Gagal menambah admin";
        errorMsg.classList.remove("hidden");
        btnSubmit.disabled = false;
        btnSubmit.textContent = "Simpan Admin";
        return;
      }

      window.location.href = "/admin/pengguna";
    } catch {
      errorMsg.textContent = "Terjadi kesalahan, coba lagi";
      errorMsg.classList.remove("hidden");
      btnSubmit.disabled = false;
      btnSubmit.textContent = "Simpan Admin";
    }
  });
</script>
