---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { KATEGORI_PROGRAM } from "../../../../lib/kategori-program";
import { renderKontenBerita } from "../../../../lib/format-konten";
import { env } from "cloudflare:workers";

const admin = Astro.locals.admin;
const id = Number(Astro.params.id);

interface ProgramRow {
  id: number;
  nama: string;
  slug: string;
  kategori: string;
  headline: string;
  deskripsi: string | null;
  konten: string | null;
  foto: string | null;
  href_custom: string | null;
  href_external: number;
  unggulan: number;
  target: number | null;
  terkumpul: number | null;
  tampilkan_progress: number;
  status: number;
}

const db = env.yasuki_db;
const program = await db.prepare("SELECT * FROM program WHERE id = ?").bind(id).first<ProgramRow>();

if (!program) {
  return Astro.redirect("/admin/program");
}

const kontenAwalHtml = program.konten ? renderKontenBerita(program.konten) : "";
---

<AdminLayout title="Edit Program — Yasuki" admin={admin}>
  <div class="max-w-2xl mx-auto">
    <h1 class="text-xl font-bold text-slate-800 mb-6">Edit Program</h1>

    <form id="form-program" class="bg-white rounded-xl shadow-sm p-6 space-y-5">
      <div>
        <label for="nama" class="block text-sm font-medium text-slate-700 mb-1">Nama Program</label>
        <input
          type="text"
          id="nama"
          name="nama"
          required
          value={program.nama}
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-700"
        />
      </div>

      <div>
        <label for="slug" class="block text-sm font-medium text-slate-700 mb-1">Slug</label>
        <input
          type="text"
          id="slug"
          name="slug"
          required
          value={program.slug}
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-700"
        />
        <p class="text-xs text-slate-400 mt-1">Dipakai untuk jangkar link di halaman Program (/program#slug).</p>
      </div>

      <div>
        <label for="kategori" class="block text-sm font-medium text-slate-700 mb-1">Kategori</label>
        <select
          id="kategori"
          name="kategori"
          required
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-700"
        >
          {KATEGORI_PROGRAM.map((k) => <option value={k} selected={k === program.kategori}>{k}</option>)}
        </select>
      </div>

      <div>
        <label for="headline" class="block text-sm font-medium text-slate-700 mb-1">Headline</label>
        <input
          type="text"
          id="headline"
          name="headline"
          required
          value={program.headline}
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-700"
        />
      </div>

      <div>
        <label for="deskripsi" class="block text-sm font-medium text-slate-700 mb-1">Deskripsi (opsional)</label>
        <textarea
          id="deskripsi"
          name="deskripsi"
          rows="3"
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-700"
          placeholder="Cuma ditampilkan kalau program ditandai Unggulan."
        >{program.deskripsi || ""}</textarea>
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Foto</label>
        <div id="foto-preview-wrapper" class={program.foto ? "mb-2" : "hidden mb-2"}>
          <img id="foto-preview" src={program.foto || ""} alt="Preview foto" class="w-full h-40 object-cover rounded-lg border border-slate-200" />
        </div>
        <label
          for="foto"
          class="flex items-center justify-center gap-2 border-2 border-dashed border-slate-300 rounded-lg py-6 px-4 cursor-pointer hover:border-blue-400 hover:bg-blue-50/50 transition text-sm text-slate-500 text-center"
        >
          <span id="foto-label-text">{program.foto ? "Ganti foto (biarkan kosong kalau tidak diganti)" : "Klik untuk pilih foto"}</span>
        </label>
        <input type="file" id="foto" name="foto" accept="image/*" class="hidden" />
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Isi Lengkap (opsional)</label>
        <div id="editor-konten" class="bg-white rounded-lg border border-slate-300" set:html={kontenAwalHtml} />
        <textarea id="konten" name="konten" class="hidden"></textarea>
        <p class="text-xs text-slate-400 mt-1">Ditampilkan di halaman detail program (/program/slug-nya). Kosongkan kalau program ini belum butuh halaman detail sendiri.</p>
      </div>

      <div class="border-t border-slate-200 pt-5">
        <label class="flex items-center gap-2 mb-3">
          <input type="checkbox" id="unggulan" checked={!!program.unggulan} class="rounded border-slate-300" />
          <span class="text-sm font-medium text-slate-700">Tampilkan sebagai Unggulan</span>
        </label>
        <p class="text-xs text-slate-400 mb-3 -mt-2">Program Unggulan tampil sebagai kartu besar dengan deskripsi di halaman Program. Program biasa tampil sebagai kartu kecil.</p>

        <div>
          <label for="href_custom" class="block text-sm font-medium text-slate-700 mb-1">Link Halaman Detail (opsional)</label>
          <input
            type="text"
            id="href_custom"
            name="href_custom"
            value={program.href_custom || ""}
            class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-700"
            placeholder="/program/pertanian atau https://situs-eksternal.com"
          />
          <p class="text-xs text-slate-400 mt-1">Kosongkan kalau nggak punya halaman detail sendiri — nanti otomatis mengarah ke bagian program ini di halaman Program.</p>
        </div>
        <label class="flex items-center gap-2 mt-2">
          <input type="checkbox" id="href_external" checked={!!program.href_external} class="rounded border-slate-300" />
          <span class="text-sm text-slate-600">Link di atas membuka tab baru (link eksternal)</span>
        </label>
      </div>

      <div class="border-t border-slate-200 pt-5">
        <p class="text-sm font-medium text-slate-700 mb-3">Progress Donasi</p>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="target" class="block text-sm text-slate-700 mb-1">Target (Rp)</label>
            <input
              type="number"
              id="target"
              name="target"
              min="0"
              value={program.target ?? ""}
              class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-700"
            />
          </div>
          <div>
            <label for="terkumpul" class="block text-sm text-slate-700 mb-1">Terkumpul (Rp)</label>
            <input
              type="number"
              id="terkumpul"
              name="terkumpul"
              min="0"
              value={program.terkumpul ?? ""}
              class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-700"
            />
          </div>
        </div>
        <label class="flex items-center gap-2 mt-3">
          <input type="checkbox" id="tampilkan_progress" checked={!!program.tampilkan_progress} class="rounded border-slate-300" />
          <span class="text-sm text-slate-600">Tampilkan progress bar di website</span>
        </label>
      </div>

      <div class="flex items-center gap-2 border-t border-slate-200 pt-5">
        <input type="checkbox" id="status" checked={!!program.status} class="rounded border-slate-300" />
        <label for="status" class="text-sm text-slate-700">Tayangkan di website</label>
      </div>

      <p id="error-msg" class="text-sm text-red-600 hidden"></p>

      <div class="flex gap-3">
        <button
          type="submit"
          id="btn-submit"
          class="bg-blue-800 hover:bg-blue-900 text-white font-medium px-4 py-2 rounded-lg text-sm disabled:opacity-60"
        >
          Simpan Perubahan
        </button>
        <a href="/admin/program" class="px-4 py-2 rounded-lg text-sm text-slate-600 hover:bg-slate-100">Batal</a>
      </div>
    </form>
  </div>
</AdminLayout>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.snow.css" />

<style>
  #editor-konten :global(.ql-editor) {
    min-height: 200px;
    font-size: 0.875rem;
  }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.min.js" is:inline></script>
<script is:inline define:vars={{ programId: id }}>
  // --- Preview foto ---
  var fotoInput = document.getElementById("foto");
  var fotoPreviewWrapper = document.getElementById("foto-preview-wrapper");
  var fotoPreviewImg = document.getElementById("foto-preview");
  var fotoLabelText = document.getElementById("foto-label-text");
  var fotoLabelDefault = fotoLabelText.textContent;

  fotoInput.addEventListener("change", function () {
    var file = fotoInput.files && fotoInput.files[0];
    if (!file) {
      fotoLabelText.textContent = fotoLabelDefault;
      return;
    }
    fotoLabelText.textContent = file.name;
    var reader = new FileReader();
    reader.onload = function (e) {
      fotoPreviewImg.src = e.target.result;
      fotoPreviewWrapper.classList.remove("hidden");
    };
    reader.readAsDataURL(file);
  });

  // --- Rich text editor (kontennya udah ke-isi dari server via set:html di atas) ---
  var quill = new Quill("#editor-konten", {
    theme: "snow",
    placeholder: "Tulis isi lengkap program di sini (opsional)...",
    modules: {
      toolbar: {
        container: [[{ header: [2, 3, false] }], ["bold", "italic", "underline"], ["blockquote"], [{ list: "ordered" }, { list: "bullet" }], ["link", "image"], ["clean"]],
        handlers: { image: imageHandler },
      },
    },
  });

  function imageHandler() {
    var input = document.createElement("input");
    input.setAttribute("type", "file");
    input.setAttribute("accept", "image/*");
    input.click();

    input.onchange = async function () {
      var file = input.files[0];
      if (!file) return;

      var range = quill.getSelection(true);
      quill.insertText(range.index, "Mengupload foto...", { italic: true });

      var fd = new FormData();
      fd.append("foto", file);

      try {
        var res = await fetch("/api/admin/program/upload-foto", { method: "POST", body: fd });
        var data = await res.json();

        quill.deleteText(range.index, "Mengupload foto...".length);

        if (!res.ok || !data.url) {
          alert(data.error || "Gagal upload foto");
          return;
        }

        quill.insertEmbed(range.index, "image", data.url);
        quill.setSelection(range.index + 1);
      } catch (err) {
        quill.deleteText(range.index, "Mengupload foto...".length);
        alert("Terjadi kesalahan, coba lagi");
      }
    };
  }

  // --- Submit form ---
  var kontenHidden = document.getElementById("konten");
  var form = document.getElementById("form-program");
  var btnSubmit = document.getElementById("btn-submit");
  var errorMsg = document.getElementById("error-msg");
  var unggulanCheckbox = document.getElementById("unggulan");
  var hrefExternalCheckbox = document.getElementById("href_external");
  var tampilkanProgressCheckbox = document.getElementById("tampilkan_progress");
  var statusCheckbox = document.getElementById("status");

  form.addEventListener("submit", async function (e) {
    e.preventDefault();
    errorMsg.classList.add("hidden");
    kontenHidden.value = quill.getText().trim().length === 0 ? "" : quill.root.innerHTML;
    btnSubmit.disabled = true;
    btnSubmit.textContent = "Menyimpan...";

    var formData = new FormData(form);
    formData.set("unggulan", unggulanCheckbox.checked ? "1" : "0");
    formData.set("href_external", hrefExternalCheckbox.checked ? "1" : "0");
    formData.set("tampilkan_progress", tampilkanProgressCheckbox.checked ? "1" : "0");
    formData.set("status", statusCheckbox.checked ? "1" : "0");

    try {
      var res = await fetch("/api/admin/program/" + programId, { method: "PUT", body: formData });
      var data = await res.json();

      if (!res.ok) {
        errorMsg.textContent = data.error || "Gagal menyimpan perubahan";
        errorMsg.classList.remove("hidden");
        btnSubmit.disabled = false;
        btnSubmit.textContent = "Simpan Perubahan";
        return;
      }

      window.location.href = "/admin/program";
    } catch (err) {
      errorMsg.textContent = "Terjadi kesalahan, coba lagi";
      errorMsg.classList.remove("hidden");
      btnSubmit.disabled = false;
      btnSubmit.textContent = "Simpan Perubahan";
    }
  });
</script>
