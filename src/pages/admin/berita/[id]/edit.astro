---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { env } from "cloudflare:workers";
import { KATEGORI_BERITA } from "../../../../lib/kategori-berita";

const admin = Astro.locals.admin;
const id = Number(Astro.params.id);

interface BeritaDetail {
  id: number;
  judul: string;
  slug: string;
  kategori: string;
  ringkasan: string;
  konten: string;
  foto: string | null;
  published: number;
}

const db = env.yasuki_db;
const berita = await db
  .prepare("SELECT id, judul, slug, kategori, ringkasan, konten, foto, published FROM berita WHERE id = ?")
  .bind(id)
  .first<BeritaDetail>();

if (!berita) {
  return Astro.redirect("/admin/berita");
}

const kategoriLamaTidakDikenal = !KATEGORI_BERITA.includes(berita.kategori);
---

<AdminLayout title={`Edit Berita — ${berita.judul}`} admin={admin}>
  <div class="max-w-2xl mx-auto">
    <h1 class="text-xl font-bold text-slate-800 mb-6">Edit Berita</h1>

    <form id="form-berita" class="bg-white rounded-xl shadow-sm p-6 space-y-5">
      <div>
        <label for="judul" class="block text-sm font-medium text-slate-700 mb-1">Judul</label>
        <input
          type="text"
          id="judul"
          name="judul"
          required
          value={berita.judul}
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-700"
        />
      </div>

      <div>
        <label for="slug" class="block text-sm font-medium text-slate-700 mb-1">Slug (URL)</label>
        <input
          type="text"
          id="slug"
          name="slug"
          required
          value={berita.slug}
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-700"
        />
      </div>

      <div>
        <label for="kategori" class="block text-sm font-medium text-slate-700 mb-1">Kategori</label>
        <select
          id="kategori"
          name="kategori"
          required
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-700"
        >
          {kategoriLamaTidakDikenal && (
            <option value={berita.kategori} selected>
              {berita.kategori} (lama)
            </option>
          )}
          {KATEGORI_BERITA.map((k) => (
            <option value={k} selected={k === berita.kategori}>
              {k}
            </option>
          ))}
        </select>
      </div>

      <div>
        <label for="ringkasan" class="block text-sm font-medium text-slate-700 mb-1">Ringkasan</label>
        <textarea
          id="ringkasan"
          name="ringkasan"
          rows="2"
          required
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-700"
          set:text={berita.ringkasan}
        ></textarea>
      </div>

      <div>
        <div class="flex items-center justify-between mb-1">
          <label for="konten" class="block text-sm font-medium text-slate-700">Isi Berita</label>
          <button type="button" id="btn-sisip-foto" class="text-xs text-blue-700 hover:underline font-medium">
            + Sisipkan foto di sini
          </button>
        </div>
        <textarea
          id="konten"
          name="konten"
          rows="10"
          required
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-700"
          set:text={berita.konten}
        ></textarea>
        <input type="file" id="input-sisip-foto" accept="image/*" class="hidden" />
        <p class="text-xs text-slate-400 mt-1">
          Ketik teks seperti biasa. Buat paragraf baru dengan Enter dua kali. Klik "Sisipkan foto" untuk menaruh foto di posisi kursor kamu sekarang.
        </p>
      </div>

      <div>
        <label for="foto" class="block text-sm font-medium text-slate-700 mb-1">Foto Sampul</label>
        {
          berita.foto && (
            <div class="mb-2">
              <img src={berita.foto} alt={berita.judul} class="w-32 h-32 object-cover rounded-lg" />
              <p class="text-xs text-slate-400 mt-1">Foto sampul saat ini. Upload baru buat ganti, atau biarkan kosong buat tetap pakai ini.</p>
            </div>
          )
        }
        <input type="file" id="foto" name="foto" accept="image/*" class="w-full text-sm" />
      </div>

      <div class="flex items-center gap-2">
        <input type="checkbox" id="published" checked={berita.published === 1} class="rounded border-slate-300" />
        <label for="published" class="text-sm text-slate-700">Tayangkan</label>
      </div>

      <p id="error-msg" class="text-sm text-red-600 hidden"></p>

      <div class="flex gap-3">
        <button
          type="submit"
          id="btn-submit"
          class="bg-blue-800 hover:bg-blue-900 text-white font-medium px-4 py-2 rounded-lg text-sm disabled:opacity-60"
        >
          Simpan Perubahan
        </button>
        <a href="/admin/berita" class="px-4 py-2 rounded-lg text-sm text-slate-600 hover:bg-slate-100">Batal</a>
      </div>
    </form>
  </div>
</AdminLayout>

<script define:vars={{ beritaId: berita.id }}>
  // --- Sisip foto di tengah isi berita ---
  const kontenTextarea = document.getElementById("konten");
  const btnSisipFoto = document.getElementById("btn-sisip-foto");
  const inputSisipFoto = document.getElementById("input-sisip-foto");

  btnSisipFoto.addEventListener("click", () => {
    inputSisipFoto.click();
  });

  inputSisipFoto.addEventListener("change", async () => {
    const file = inputSisipFoto.files?.[0];
    if (!file) return;

    const originalLabel = btnSisipFoto.textContent;
    btnSisipFoto.textContent = "Mengupload...";
    btnSisipFoto.disabled = true;

    const fd = new FormData();
    fd.append("foto", file);

    try {
      const res = await fetch("/api/admin/berita/upload-foto", { method: "POST", body: fd });
      const data = await res.json();

      if (!res.ok || !data.url) {
        alert(data.error || "Gagal upload foto");
        return;
      }

      const placeholder = `\n[FOTO:${data.url}]\n`;
      const start = kontenTextarea.selectionStart;
      const end = kontenTextarea.selectionEnd;
      const text = kontenTextarea.value;
      kontenTextarea.value = text.slice(0, start) + placeholder + text.slice(end);
      kontenTextarea.focus();
      const newPos = start + placeholder.length;
      kontenTextarea.setSelectionRange(newPos, newPos);
    } catch {
      alert("Terjadi kesalahan, coba lagi");
    } finally {
      btnSisipFoto.textContent = originalLabel;
      btnSisipFoto.disabled = false;
      inputSisipFoto.value = "";
    }
  });

  // --- Submit form ---
  const form = document.getElementById("form-berita");
  const btnSubmit = document.getElementById("btn-submit");
  const errorMsg = document.getElementById("error-msg");
  const publishedCheckbox = document.getElementById("published");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorMsg.classList.add("hidden");
    btnSubmit.disabled = true;
    btnSubmit.textContent = "Menyimpan...";

    const formData = new FormData(form);
    formData.set("published", publishedCheckbox.checked ? "1" : "0");

    try {
      const res = await fetch(`/api/admin/berita/${beritaId}`, {
        method: "PUT",
        body: formData,
      });

      const data = await res.json();

      if (!res.ok) {
        errorMsg.textContent = data.error || "Gagal menyimpan perubahan";
        errorMsg.classList.remove("hidden");
        btnSubmit.disabled = false;
        btnSubmit.textContent = "Simpan Perubahan";
        return;
      }

      window.location.href = "/admin/berita";
    } catch {
      errorMsg.textContent = "Terjadi kesalahan, coba lagi";
      errorMsg.classList.remove("hidden");
      btnSubmit.disabled = false;
      btnSubmit.textContent = "Simpan Perubahan";
    }
  });
</script>
