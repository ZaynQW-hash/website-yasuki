---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { env } from "cloudflare:workers";
import { KATEGORI_BERITA } from "../../../../lib/kategori-berita";
import { renderKontenBerita } from "../../../../lib/format-konten";

const admin = Astro.locals.admin;
const id = Number(Astro.params.id);

interface BeritaDetail {
  id: number;
  judul: string;
  slug: string;
  kategori: string;
  penulis: string | null;
  ringkasan: string;
  konten: string;
  foto: string | null;
  published: number;
}

const db = env.yasuki_db;
const berita = await db
  .prepare("SELECT id, judul, slug, kategori, penulis, ringkasan, konten, foto, published FROM berita WHERE id = ?")
  .bind(id)
  .first<BeritaDetail>();

if (!berita) {
  return Astro.redirect("/admin/berita");
}

const kategoriLamaTidakDikenal = !KATEGORI_BERITA.includes(berita.kategori);
const kontenAwalHtml = renderKontenBerita(berita.konten);
---

<AdminLayout title={`Edit Berita — ${berita.judul}`} admin={admin}>
  <div class="max-w-2xl mx-auto">
    <h1 class="text-xl font-bold text-slate-800 mb-6">Edit Berita</h1>

    <form id="form-berita" class="bg-white rounded-xl shadow-sm p-6 space-y-5">
      <div>
        <label for="judul" class="block text-sm font-medium text-slate-700 mb-1">Judul</label>
        <input
          type="text"
          id="judul"
          name="judul"
          required
          value={berita.judul}
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-700"
        />
      </div>

      <div>
        <label for="slug" class="block text-sm font-medium text-slate-700 mb-1">Slug (URL)</label>
        <input
          type="text"
          id="slug"
          name="slug"
          required
          value={berita.slug}
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-700"
        />
      </div>

      <div>
        <label for="kategori" class="block text-sm font-medium text-slate-700 mb-1">Kategori</label>
        <select
          id="kategori"
          name="kategori"
          required
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-700"
        >
          {kategoriLamaTidakDikenal && (
            <option value={berita.kategori} selected>
              {berita.kategori} (lama)
            </option>
          )}
          {KATEGORI_BERITA.map((k) => (
            <option value={k} selected={k === berita.kategori}>
              {k}
            </option>
          ))}
        </select>
      </div>

      <div>
        <label for="penulis" class="block text-sm font-medium text-slate-700 mb-1">Nama Pengupload</label>
        <input
          type="text"
          id="penulis"
          name="penulis"
          value={berita.penulis || ""}
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-700"
          placeholder="Nama yang menulis berita ini (opsional)"
        />
      </div>

      <div>
        <label for="ringkasan" class="block text-sm font-medium text-slate-700 mb-1">Ringkasan</label>
        <textarea
          id="ringkasan"
          name="ringkasan"
          rows="2"
          required
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-700"
          set:text={berita.ringkasan}
        ></textarea>
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Foto Sampul</label>
        <label
          for="foto"
          class="flex items-center justify-center gap-2 border-2 border-dashed border-slate-300 rounded-lg py-6 px-4 cursor-pointer hover:border-blue-400 hover:bg-blue-50/50 transition text-sm text-slate-500 text-center"
        >
          <span id="foto-label-text">{berita.foto ? "Klik untuk ganti foto sampul" : "Klik untuk pilih foto sampul"}</span>
        </label>
        <input type="file" id="foto" name="foto" accept="image/*" class="hidden" />
        <p class="text-xs text-slate-400 mt-1">Biarkan kosong buat tetap pakai foto yang sekarang.</p>
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Isi Berita</label>
        <div id="editor-konten" class="bg-white rounded-lg border border-slate-300" set:html={kontenAwalHtml} />
        <textarea id="konten" name="konten" class="hidden"></textarea>
        <p class="text-xs text-slate-400 mt-1">Pakai toolbar buat bold, heading, list, link, dan tombol gambar buat sisip foto langsung di teks.</p>
      </div>

      <div class="flex items-center gap-2">
        <input type="checkbox" id="published" checked={berita.published === 1} class="rounded border-slate-300" />
        <label for="published" class="text-sm text-slate-700">Tayangkan</label>
      </div>

      <p id="error-msg" class="text-sm text-red-600 hidden"></p>

      <div class="flex gap-3">
        <button
          type="submit"
          id="btn-submit"
          class="bg-blue-800 hover:bg-blue-900 text-white font-medium px-4 py-2 rounded-lg text-sm disabled:opacity-60"
        >
          Simpan Perubahan
        </button>
        <a href="/admin/berita" class="px-4 py-2 rounded-lg text-sm text-slate-600 hover:bg-slate-100">Batal</a>
      </div>
    </form>
  </div>
</AdminLayout>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.snow.css" />

<style>
  #editor-konten :global(.ql-editor) {
    min-height: 260px;
    font-size: 0.875rem;
  }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.min.js" is:inline></script>
<script define:vars={{ beritaId: berita.id }}>
  // --- Nama file foto sampul (tanpa preview gambar) ---
  var fotoInput = document.getElementById("foto");
  var fotoLabelText = document.getElementById("foto-label-text");

  fotoInput.addEventListener("change", function () {
    var file = fotoInput.files && fotoInput.files[0];
    if (!file) return;
    fotoLabelText.textContent = file.name;
  });

  // --- Rich text editor (kontennya udah ke-isi dari server via set:html di atas) ---
  var quill = new Quill("#editor-konten", {
    theme: "snow",
    placeholder: "Tulis isi berita di sini...",
    modules: {
      toolbar: {
        container: [[{ header: [2, 3, false] }], ["bold", "italic", "underline"], [{ align: [] }], ["blockquote"], [{ list: "ordered" }, { list: "bullet" }], ["link", "image"], ["clean"]],
        handlers: { image: imageHandler },
      },
    },
  });

  function imageHandler() {
    var input = document.createElement("input");
    input.setAttribute("type", "file");
    input.setAttribute("accept", "image/*");
    input.click();

    input.onchange = async function () {
      var file = input.files[0];
      if (!file) return;

      var range = quill.getSelection(true);
      quill.insertText(range.index, "Mengupload foto...", { italic: true });

      var fd = new FormData();
      fd.append("foto", file);

      try {
        var res = await fetch("/api/admin/berita/upload-foto", { method: "POST", body: fd });
        var data = await res.json();

        quill.deleteText(range.index, "Mengupload foto...".length);

        if (!res.ok || !data.url) {
          alert(data.error || "Gagal upload foto");
          return;
        }

        quill.insertEmbed(range.index, "image", data.url);
        quill.setSelection(range.index + 1);
      } catch (err) {
        quill.deleteText(range.index, "Mengupload foto...".length);
        alert("Terjadi kesalahan, coba lagi");
      }
    };
  }

  // --- Submit form ---
  var form = document.getElementById("form-berita");
  var btnSubmit = document.getElementById("btn-submit");
  var errorMsg = document.getElementById("error-msg");
  var publishedCheckbox = document.getElementById("published");
  var kontenHidden = document.getElementById("konten");

  form.addEventListener("submit", async function (e) {
    e.preventDefault();
    errorMsg.classList.add("hidden");

    kontenHidden.value = quill.root.innerHTML;

    if (quill.getText().trim().length === 0) {
      errorMsg.textContent = "Isi berita tidak boleh kosong";
      errorMsg.classList.remove("hidden");
      return;
    }

    btnSubmit.disabled = true;
    btnSubmit.textContent = "Menyimpan...";

    var formData = new FormData(form);
    formData.set("published", publishedCheckbox.checked ? "1" : "0");

    try {
      var res = await fetch("/api/admin/berita/" + beritaId, { method: "PUT", body: formData });
      var data = await res.json();

      if (!res.ok) {
        errorMsg.textContent = data.error || "Gagal menyimpan perubahan";
        errorMsg.classList.remove("hidden");
        btnSubmit.disabled = false;
        btnSubmit.textContent = "Simpan Perubahan";
        return;
      }

      window.location.href = "/admin/berita";
    } catch (err) {
      errorMsg.textContent = "Terjadi kesalahan, coba lagi";
      errorMsg.classList.remove("hidden");
      btnSubmit.disabled = false;
      btnSubmit.textContent = "Simpan Perubahan";
    }
  });
</script>
