---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { KATEGORI_BERITA } from "../../../lib/kategori-berita";

const admin = Astro.locals.admin;
---

<AdminLayout title="Tambah Berita — Yasuki" admin={admin}>
  <div class="max-w-2xl mx-auto">
    <h1 class="text-xl font-bold text-slate-800 mb-6">Tambah Berita</h1>

    <form id="form-berita" class="bg-white rounded-xl shadow-sm p-6 space-y-5">
      <div>
        <label for="judul" class="block text-sm font-medium text-slate-700 mb-1">Judul</label>
        <input
          type="text"
          id="judul"
          name="judul"
          required
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-700"
        />
      </div>

      <div>
        <label for="slug" class="block text-sm font-medium text-slate-700 mb-1">Slug (URL)</label>
        <input
          type="text"
          id="slug"
          name="slug"
          required
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-700"
        />
        <p class="text-xs text-slate-400 mt-1">Otomatis dari judul, bisa diedit manual. Contoh: update-pembangunan-lantai-2</p>
      </div>

      <div>
        <label for="kategori" class="block text-sm font-medium text-slate-700 mb-1">Kategori</label>
        <select
          id="kategori"
          name="kategori"
          required
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-700"
        >
          <option value="" disabled selected>Pilih kategori</option>
          {KATEGORI_BERITA.map((k) => <option value={k}>{k}</option>)}
        </select>
      </div>

      <div>
        <label for="penulis" class="block text-sm font-medium text-slate-700 mb-1">Nama Pengupload</label>
        <input
          type="text"
          id="penulis"
          name="penulis"
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-700"
          placeholder="Nama yang menulis berita ini (opsional)"
        />
      </div>

      <div>
        <label for="ringkasan" class="block text-sm font-medium text-slate-700 mb-1">Ringkasan</label>
        <textarea
          id="ringkasan"
          name="ringkasan"
          rows="2"
          required
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-700"
        ></textarea>
        <p class="text-xs text-slate-400 mt-1">Ditampilkan sebagai cuplikan singkat di halaman daftar berita.</p>
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Foto Sampul</label>
        <label
          for="foto"
          class="flex items-center justify-center gap-2 border-2 border-dashed border-slate-300 rounded-lg py-6 px-4 cursor-pointer hover:border-blue-400 hover:bg-blue-50/50 transition text-sm text-slate-500 text-center"
        >
          <span id="foto-label-text">Klik untuk pilih foto sampul</span>
        </label>
        <input type="file" id="foto" name="foto" accept="image/*" class="hidden" />
        <p class="text-xs text-slate-400 mt-1">Otomatis dikompres & diubah ke JPEG. Foto utama yang muncul di kartu daftar berita & halaman detail.</p>
      </div>

      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="block text-sm font-medium text-slate-700">Isi Berita</label>
          <button type="button" id="btn-toggle-html" class="text-xs text-blue-700 hover:underline font-medium">&lt;/&gt; Kode HTML</button>
        </div>

        <div id="editor-wrapper">
          <div id="editor-konten" class="bg-white rounded-lg border border-slate-300"></div>
        </div>
        <textarea
          id="html-source"
          class="hidden w-full rounded-lg border border-slate-300 px-3 py-2 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-blue-700"
          rows="14"
          spellcheck="false"
        ></textarea>

        <textarea id="konten" name="konten" class="hidden"></textarea>
        <p id="editor-help-text" class="text-xs text-slate-400 mt-1">
          Pakai toolbar buat bold, heading, list, link, dan tombol gambar buat sisip foto langsung di teks.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <input type="checkbox" id="published" checked class="rounded border-slate-300" />
        <label for="published" class="text-sm text-slate-700">Langsung tayangkan</label>
      </div>

      <p id="error-msg" class="text-sm text-red-600 hidden"></p>

      <div class="flex gap-3">
        <button
          type="submit"
          id="btn-submit"
          class="bg-blue-800 hover:bg-blue-900 text-white font-medium px-4 py-2 rounded-lg text-sm disabled:opacity-60"
        >
          Simpan Berita
        </button>
        <a href="/admin/berita" class="px-4 py-2 rounded-lg text-sm text-slate-600 hover:bg-slate-100">Batal</a>
      </div>
    </form>
  </div>
</AdminLayout>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.snow.css" />

<style>
  #editor-konten :global(.ql-editor) {
    min-height: 260px;
    font-size: 0.875rem;
  }
</style>

<script src="/js/compress-image.js" is:inline></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.min.js" is:inline></script>
<script is:inline>
  function slugify(text) {
    return text
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9\s-]/g, "")
      .replace(/\s+/g, "-")
      .replace(/-+/g, "-");
  }

  var judulInput = document.getElementById("judul");
  var slugInput = document.getElementById("slug");
  var slugManuallyEdited = false;

  slugInput.addEventListener("input", function () {
    slugManuallyEdited = true;
  });

  judulInput.addEventListener("input", function () {
    if (!slugManuallyEdited) {
      slugInput.value = slugify(judulInput.value);
    }
  });

  // --- Nama file foto sampul (tanpa preview gambar) ---
  var fotoInput = document.getElementById("foto");
  var fotoLabelText = document.getElementById("foto-label-text");

  fotoInput.addEventListener("change", function () {
    var file = fotoInput.files && fotoInput.files[0];
    fotoLabelText.textContent = file ? file.name : "Klik untuk pilih foto sampul";
  });

  // --- Rich text editor ---
  var quill = new Quill("#editor-konten", {
    theme: "snow",
    placeholder: "Tulis isi berita di sini...",
    modules: {
      toolbar: {
        container: [[{ header: [2, 3, false] }], ["bold", "italic", "underline"], [{ align: [] }], ["blockquote"], [{ list: "ordered" }, { list: "bullet" }], ["link", "image"], ["clean"]],
        handlers: { image: imageHandler },
      },
    },
  });

  function imageHandler() {
    var input = document.createElement("input");
    input.setAttribute("type", "file");
    input.setAttribute("accept", "image/*");
    input.click();

    input.onchange = async function () {
      var file = input.files[0];
      if (!file) return;

      var range = quill.getSelection(true);
      quill.insertText(range.index, "Mengupload foto...", { italic: true });

      try {
        file = await window.compressToJpeg(file);
      } catch (err) {
        // kalau compress gagal, lanjut pakai file asli
      }

      var fd = new FormData();
      fd.append("foto", file);

      try {
        var res = await fetch("/api/admin/berita/upload-foto", { method: "POST", body: fd });
        var data = await res.json();

        quill.deleteText(range.index, "Mengupload foto...".length);

        if (!res.ok || !data.url) {
          alert(data.error || "Gagal upload foto");
          return;
        }

        quill.insertEmbed(range.index, "image", data.url);
        quill.setSelection(range.index + 1);
      } catch (err) {
        quill.deleteText(range.index, "Mengupload foto...".length);
        alert("Terjadi kesalahan, coba lagi");
      }
    };
  }

  // --- Toggle mode HTML mentah ---
  var btnToggleHtml = document.getElementById("btn-toggle-html");
  var editorWrapper = document.getElementById("editor-wrapper");
  var htmlSourceTextarea = document.getElementById("html-source");
  var editorHelpText = document.getElementById("editor-help-text");
  var modeHtml = false;

  var HELP_TEXT_VISUAL = "Pakai toolbar buat bold, heading, list, link, dan tombol gambar buat sisip foto langsung di teks.";
  var HELP_TEXT_HTML =
    "Mode ini buat nulis/tempel kode HTML langsung — cocok buat sisip video YouTube (embed iframe), tabel custom, formulir, atau elemen lain yang nggak ada tombolnya di toolbar. Klik lagi tombolnya buat balik ke editor visual biasa.";

  function masukModeHtml() {
    htmlSourceTextarea.value = quill.root.innerHTML;
    editorWrapper.classList.add("hidden");
    htmlSourceTextarea.classList.remove("hidden");
    btnToggleHtml.textContent = "Kembali ke Editor Visual";
    editorHelpText.textContent = HELP_TEXT_HTML;
    modeHtml = true;
  }

  function keluarModeHtml() {
    var delta = quill.clipboard.convert(htmlSourceTextarea.value);
    quill.setContents(delta, "silent");
    editorWrapper.classList.remove("hidden");
    htmlSourceTextarea.classList.add("hidden");
    btnToggleHtml.textContent = "</> Kode HTML";
    editorHelpText.textContent = HELP_TEXT_VISUAL;
    modeHtml = false;
  }

  btnToggleHtml.addEventListener("click", function () {
    if (modeHtml) {
      keluarModeHtml();
    } else {
      masukModeHtml();
    }
  });

  // --- Submit form ---
  var form = document.getElementById("form-berita");
  var btnSubmit = document.getElementById("btn-submit");
  var errorMsg = document.getElementById("error-msg");
  var publishedCheckbox = document.getElementById("published");
  var kontenHidden = document.getElementById("konten");

  form.addEventListener("submit", async function (e) {
    e.preventDefault();
    errorMsg.classList.add("hidden");

    // Kalau lagi di mode HTML pas submit, sinkronin dulu balik ke editor visual
    if (modeHtml) {
      keluarModeHtml();
    }

    kontenHidden.value = quill.root.innerHTML;

    if (quill.getText().trim().length === 0) {
      errorMsg.textContent = "Isi berita tidak boleh kosong";
      errorMsg.classList.remove("hidden");
      return;
    }

    btnSubmit.disabled = true;
    btnSubmit.textContent = "Memproses foto...";

    var formData = new FormData(form);
    formData.set("published", publishedCheckbox.checked ? "1" : "0");

    var fotoFile = fotoInput.files && fotoInput.files[0];
    if (fotoFile) {
      try {
        var compressed = await window.compressToJpeg(fotoFile);
        formData.set("foto", compressed, compressed.name);
      } catch (err) {
        // kalau compress gagal, lanjut pakai file asli
      }
    }

    btnSubmit.textContent = "Menyimpan...";

    try {
      var res = await fetch("/api/admin/berita", { method: "POST", body: formData });
      var data = await res.json();

      if (!res.ok) {
        errorMsg.textContent = data.error || "Gagal menyimpan berita";
        errorMsg.classList.remove("hidden");
        btnSubmit.disabled = false;
        btnSubmit.textContent = "Simpan Berita";
        return;
      }

      window.location.href = "/admin/berita";
    } catch (err) {
      errorMsg.textContent = "Terjadi kesalahan, coba lagi";
      errorMsg.classList.remove("hidden");
      btnSubmit.disabled = false;
      btnSubmit.textContent = "Simpan Berita";
    }
  });
</script>
