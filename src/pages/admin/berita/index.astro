---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { env } from "cloudflare:workers";

const admin = Astro.locals.admin;

interface BeritaRow {
  id: number;
  judul: string;
  slug: string;
  kategori: string;
  foto: string | null;
  published: number;
  created_at: string;
}

const PER_PAGE = 20;
const page = Math.max(1, parseInt(Astro.url.searchParams.get("page") || "1", 10) || 1);
const offset = (page - 1) * PER_PAGE;

const db = env.yasuki_db;
const { results: countRows } = await db.prepare("SELECT COUNT(*) as total FROM berita").all<{ total: number }>();
const totalItems = countRows[0]?.total || 0;
const totalPages = Math.max(1, Math.ceil(totalItems / PER_PAGE));

const { results } = await db
  .prepare("SELECT id, judul, slug, kategori, foto, published, created_at FROM berita ORDER BY created_at DESC LIMIT ?1 OFFSET ?2")
  .bind(PER_PAGE, offset)
  .all<BeritaRow>();

function formatTanggal(iso: string): string {
  return new Date(iso.replace(" ", "T") + "Z").toLocaleDateString("id-ID", { dateStyle: "medium" });
}
---

<AdminLayout title="Kelola Berita — Yasuki" admin={admin}>
  <div class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-xl font-bold text-slate-800">Kelola Berita</h1>
      <a href="/admin/berita/tambah" class="bg-blue-800 hover:bg-blue-900 text-white text-sm font-medium px-4 py-2 rounded-lg">
        + Tambah Berita
      </a>
    </div>

    <div class="bg-white rounded-xl shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-slate-500 text-left">
            <tr>
              <th class="px-4 py-3 font-medium">Judul</th>
              <th class="px-4 py-3 font-medium">Kategori</th>
              <th class="px-4 py-3 font-medium">Tanggal</th>
              <th class="px-4 py-3 font-medium">Status</th>
              <th class="px-4 py-3 font-medium">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {
              results.length === 0 && (
                <tr>
                  <td colspan="5" class="px-4 py-8 text-center text-slate-400">
                    Belum ada berita.
                  </td>
                </tr>
              )
            }
            {
              results.map((b) => (
                <tr>
                  <td class="px-4 py-3 text-slate-800 font-medium max-w-xs truncate">{b.judul}</td>
                  <td class="px-4 py-3 text-slate-600">{b.kategori}</td>
                  <td class="px-4 py-3 text-slate-600 whitespace-nowrap">{formatTanggal(b.created_at)}</td>
                  <td class="px-4 py-3">
                    <span class={`px-2 py-1 rounded-full text-xs font-medium ${b.published ? "bg-green-100 text-green-800" : "bg-slate-200 text-slate-600"}`}>
                      {b.published ? "Tayang" : "Draft"}
                    </span>
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap">
                    <div class="flex gap-2">
                      <a href={`/admin/berita/${b.id}/edit`} class="text-xs px-2 py-1 rounded-lg bg-blue-100 hover:bg-blue-200 text-blue-700">
                        Edit
                      </a>
                      <button class="btn-hapus text-xs px-2 py-1 rounded-lg bg-red-100 hover:bg-red-200 text-red-700" data-id={b.id}>
                        Hapus
                      </button>
                    </div>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    {
      totalPages > 1 && (
        <div class="flex items-center justify-between mt-4 text-sm text-slate-500">
          <p>
            Halaman {page} dari {totalPages} ({totalItems} berita)
          </p>
          <div class="flex gap-2">
            <a
              href={page > 1 ? `/admin/berita?page=${page - 1}` : undefined}
              aria-disabled={page <= 1}
              class={`px-3 py-1.5 rounded-lg border text-sm font-medium ${
                page <= 1
                  ? "border-slate-200 text-slate-300 pointer-events-none"
                  : "border-slate-300 text-slate-600 hover:bg-slate-100"
              }`}
            >
              ← Sebelumnya
            </a>
            <a
              href={page < totalPages ? `/admin/berita?page=${page + 1}` : undefined}
              aria-disabled={page >= totalPages}
              class={`px-3 py-1.5 rounded-lg border text-sm font-medium ${
                page >= totalPages
                  ? "border-slate-200 text-slate-300 pointer-events-none"
                  : "border-slate-300 text-slate-600 hover:bg-slate-100"
              }`}
            >
              Berikutnya →
            </a>
          </div>
        </div>
      )
    }
  </div>
</AdminLayout>

<script>
  document.querySelectorAll(".btn-hapus").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const id = (btn as HTMLElement).dataset.id;
      if (!confirm("Hapus berita ini? Tindakan tidak bisa dibatalkan.")) return;
      const res = await fetch(`/api/admin/berita/${id}`, { method: "DELETE" });
      if (res.ok) {
        window.location.reload();
      } else {
        alert("Gagal menghapus berita.");
      }
    });
  });
</script>
