---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ArtikelKonten from '../../components/ArtikelKonten.astro';
import { env } from "cloudflare:workers";
import { renderKontenBerita } from "../../lib/format-konten";

const { slug } = Astro.params;

interface BeritaDetail {
  id: number;
  judul: string;
  slug: string;
  kategori: string;
  penulis: string | null;
  ringkasan: string;
  konten: string;
  foto: string | null;
  published: number;
  created_at: string;
}

const db = env.yasuki_db;
const berita = await db
  .prepare("SELECT id, judul, slug, kategori, penulis, ringkasan, konten, foto, published, created_at FROM berita WHERE slug = ?")
  .bind(slug)
  .first<BeritaDetail>();

if (!berita || berita.published !== 1) {
  return Astro.redirect("/berita");
}

function formatTanggal(iso: string): string {
  return new Date(iso.replace(" ", "T") + "Z").toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" });
}

const kontenHtml = renderKontenBerita(berita.konten);
---
<Layout title={`${berita.judul} — Yasuki`}>
  <!-- Strip breadcrumb - bukan sampul, cuma buat navigasi -->
  <section class="pt-24 pb-6 px-6 bg-blue-950">
    <div class="max-w-2xl mx-auto">
      <Breadcrumb items={[{ label: "Beranda", href: "/" }, { label: "Berita", href: "/berita" }, { label: berita.judul }]} />
    </div>
  </section>

  <section class="px-6 pt-8 pb-16 bg-white">
    <div class="max-w-2xl mx-auto">
      <!-- Kategori -->
      <span class="inline-block bg-amber-50 text-amber-700 text-xs font-semibold px-3 py-1 rounded-full mb-4 fade-in-up">
        {berita.kategori}
      </span>

      <!-- Foto -->
      {berita.foto && <img src={berita.foto} alt={berita.judul} class="w-full rounded-xl mb-6 fade-in-up" />}

      <!-- Judul -->
      <h1 class="text-2xl md:text-3xl font-bold text-blue-950 mb-3 leading-tight fade-in-up">{berita.judul}</h1>

      <!-- Tanggal (+ nama pengupload kalau ada) -->
      <p class="text-slate-500 text-sm mb-8 fade-in-up">
        {berita.penulis && (
          <>
            Oleh <span class="font-medium text-slate-600">{berita.penulis}</span> ·{" "}
          </>
        )}
        {formatTanggal(berita.created_at)}
      </p>

      <ArtikelKonten html={kontenHtml} class="text-slate-700 fade-in-up fade-in-delay" />

      <div class="mt-10 pt-6 border-t border-slate-200">
        <a href="/berita" class="text-blue-700 font-medium text-sm hover:underline">← Kembali ke semua berita</a>
      </div>
    </div>
  </section>

  <!-- CTA Penutup -->
  <section class="px-6 py-16 bg-gradient-to-br from-amber-400 to-amber-500 text-center">
    <h2 class="text-xl md:text-2xl font-bold text-slate-900 mb-3">Ingin Jadi Bagian dari Kabar Baik Berikutnya?</h2>
    <p class="text-slate-800 max-w-md mx-auto mb-6">
      Donasi kamu bisa jadi cerita baik yang kami bagikan di halaman ini.
    </p>
    <a href="/donasi" class="inline-block bg-slate-900 text-white px-8 py-3 rounded-lg font-semibold hover:bg-slate-800 transition">
      Donasi Sekarang
    </a>
  </section>
</Layout>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .fade-in-up {
    animation: fadeInUp 0.6s ease-out both;
  }
  .fade-in-delay {
    animation-delay: 0.15s;
  }
</style>
