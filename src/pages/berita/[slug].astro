---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { env } from "cloudflare:workers";
import { renderKontenBerita } from "../../lib/format-konten";

const { slug } = Astro.params;

interface BeritaDetail {
  id: number;
  judul: string;
  slug: string;
  kategori: string;
  ringkasan: string;
  konten: string;
  foto: string | null;
  published: number;
  created_at: string;
}

const db = env.yasuki_db;
const berita = await db
  .prepare("SELECT id, judul, slug, kategori, ringkasan, konten, foto, published, created_at FROM berita WHERE slug = ?")
  .bind(slug)
  .first<BeritaDetail>();

if (!berita || berita.published !== 1) {
  return Astro.redirect("/berita");
}

function formatTanggal(iso: string): string {
  return new Date(iso.replace(" ", "T") + "Z").toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" });
}

const kontenHtml = renderKontenBerita(berita.konten);
---
<Layout title={`${berita.judul} — Yasuki`}>
  <section class="relative pt-24 pb-16 px-6 text-center overflow-hidden">
    {
      berita.foto ? (
        <img src={berita.foto} alt={berita.judul} class="absolute inset-0 w-full h-full object-cover" />
      ) : (
        <div class="absolute inset-0 bg-blue-950" />
      )
    }
    <div class="absolute inset-0 bg-blue-950/85"></div>
    <Breadcrumb items={[{ label: "Beranda", href: "/" }, { label: "Berita", href: "/berita" }, { label: berita.judul }]} />
    <div class="relative z-10 mt-6">
      <span class="inline-block bg-amber-400 text-slate-900 text-xs font-semibold px-3 py-1 rounded-full mb-4">
        {berita.kategori}
      </span>
      <h1 class="text-2xl md:text-4xl font-bold text-white mb-4 max-w-3xl mx-auto">{berita.judul}</h1>
      <p class="text-blue-200 text-sm">{formatTanggal(berita.created_at)}</p>
    </div>
  </section>

  <section class="px-6 py-16 bg-white">
    <article class="max-w-2xl mx-auto text-slate-700" set:html={kontenHtml} />

    <div class="max-w-2xl mx-auto mt-10 pt-6 border-t border-slate-200">
      <a href="/berita" class="text-blue-700 font-medium text-sm hover:underline">← Kembali ke semua berita</a>
    </div>
  </section>

  <!-- CTA Penutup -->
  <section class="px-6 py-16 bg-gradient-to-br from-amber-400 to-amber-500 text-center">
    <h2 class="text-xl md:text-2xl font-bold text-slate-900 mb-3">Ingin Jadi Bagian dari Kabar Baik Berikutnya?</h2>
    <p class="text-slate-800 max-w-md mx-auto mb-6">
      Donasi kamu bisa jadi cerita baik yang kami bagikan di halaman ini.
    </p>
    <a href="/donasi" class="inline-block bg-slate-900 text-white px-8 py-3 rounded-lg font-semibold hover:bg-slate-800 transition">
      Donasi Sekarang
    </a>
  </section>
</Layout>
