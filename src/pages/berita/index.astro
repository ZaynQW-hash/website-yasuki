---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { env } from "cloudflare:workers";

interface BeritaRow {
  id: number;
  judul: string;
  slug: string;
  kategori: string;
  ringkasan: string;
  foto: string | null;
  created_at: string;
}

const db = env.yasuki_db;
const { results } = await db
  .prepare("SELECT id, judul, slug, kategori, ringkasan, foto, created_at FROM berita WHERE published = 1 ORDER BY created_at DESC")
  .all<BeritaRow>();

const [featured, ...sisanya] = results;

function formatTanggal(iso: string): string {
  return new Date(iso.replace(" ", "T") + "Z").toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" });
}
---
<Layout title="Berita — Yasuki">
  <section class="relative pt-24 pb-16 px-6 text-center overflow-hidden">
    <img src="/images/program/bimbel-gratis.jpg" alt="Kegiatan Yasuki" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-blue-950/85"></div>
    <Breadcrumb items={[{ label: "Beranda", href: "/" }, { label: "Berita" }]} />
    <div class="relative z-10 mt-6">
      <p class="text-amber-400 font-medium text-sm uppercase tracking-wide mb-2">Kabar Yasuki</p>
      <h1 class="text-3xl md:text-5xl font-bold text-white mb-4">Berita & Kegiatan</h1>
      <p class="text-blue-100 max-w-xl mx-auto">
        Kabar terbaru dari lapangan — santunan, kegiatan sosial, dan progres program-program Yasuki.
      </p>
    </div>
  </section>

  <section class="px-6 py-16 bg-white">
    <div class="max-w-6xl mx-auto">
      {
        results.length === 0 && (
          <p class="text-center text-slate-400 py-16">Belum ada berita yang tayang.</p>
        )
      }

      {
        featured && (
          <a
            href={`/berita/${featured.slug}`}
            class="reveal group block bg-slate-50 border border-slate-200 rounded-xl overflow-hidden mb-10 md:grid md:grid-cols-2 transition-shadow hover:shadow-lg"
          >
            <div class="h-56 md:h-full overflow-hidden">
              {featured.foto ? (
                <img src={featured.foto} alt={featured.judul} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              ) : (
                <div class="w-full h-full bg-slate-200" />
              )}
            </div>
            <div class="p-6 flex flex-col justify-center">
              <span class="inline-block bg-amber-50 text-amber-700 text-xs font-medium px-3 py-1 rounded-full mb-3 w-fit">
                {featured.kategori}
              </span>
              <h2 class="text-xl md:text-2xl font-bold text-blue-950 mb-2 line-clamp-2">{featured.judul}</h2>
              <p class="text-slate-500 text-xs mb-3">{formatTanggal(featured.created_at)}</p>
              <p class="text-slate-600 text-sm line-clamp-3">{featured.ringkasan}</p>
            </div>
          </a>
        )
      }

      {
        sisanya.length > 0 && (
          <div class="grid md:grid-cols-3 gap-6">
            {sisanya.map((b, i) => (
              <a
                href={`/berita/${b.slug}`}
                class="reveal group bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm flex flex-col transition-all duration-300 hover:shadow-lg hover:-translate-y-1"
                style={`transition-delay: ${Math.min(i * 80, 400)}ms`}
              >
                <div class="h-40 overflow-hidden">
                  {b.foto ? (
                    <img src={b.foto} alt={b.judul} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                  ) : (
                    <div class="w-full h-full bg-slate-200" />
                  )}
                </div>
                <div class="p-4 flex flex-col flex-1">
                  <span class="inline-block bg-amber-50 text-amber-700 text-[10px] font-medium px-2.5 py-0.5 rounded-full mb-2 w-fit">
                    {b.kategori}
                  </span>
                  <h3 class="text-blue-950 font-semibold text-sm mb-1 line-clamp-2">{b.judul}</h3>
                  <p class="text-slate-500 text-xs mb-2">{formatTanggal(b.created_at)}</p>
                  <p class="text-slate-600 text-xs line-clamp-3 flex-1">{b.ringkasan}</p>
                </div>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- CTA Penutup -->
  <section class="px-6 py-16 bg-gradient-to-br from-amber-400 to-amber-500 text-center">
    <h2 class="text-xl md:text-2xl font-bold text-slate-900 mb-3">Ingin Jadi Bagian dari Kabar Baik Berikutnya?</h2>
    <p class="text-slate-800 max-w-md mx-auto mb-6">
      Donasi kamu bisa jadi cerita baik yang kami bagikan di halaman ini.
    </p>
    <a href="/donasi" class="inline-block bg-slate-900 text-white px-8 py-3 rounded-lg font-semibold hover:bg-slate-800 transition">
      Donasi Sekarang
    </a>
  </section>
</Layout>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition-property: opacity, transform;
    transition-duration: 0.7s;
    transition-timing-function: ease-out;
  }
  .reveal.revealed {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const items = document.querySelectorAll(".reveal");

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("revealed");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 },
    );

    items.forEach((item) => observer.observe(item));
  } else {
    items.forEach((item) => item.classList.add("revealed"));
  }
</script>
