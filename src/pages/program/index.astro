---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { env } from "cloudflare:workers";

interface ProgramRow {
  nama: string;
  slug: string;
  kategori: string;
  deskripsi: string | null;
  foto: string | null;
  href_custom: string | null;
  href_external: number;
}

const db = env.yasuki_db;

const { results: unggulanRows } = await db
  .prepare(
    "SELECT nama, slug, kategori, deskripsi, foto, href_custom, href_external FROM program WHERE status = 1 AND unggulan = 1 ORDER BY urutan ASC, id ASC",
  )
  .all<ProgramRow>();

const unggulan = unggulanRows.map((p) => ({
  nama: p.nama,
  slug: p.slug,
  kategori: p.kategori,
  deskripsi: p.deskripsi,
  foto: p.foto,
  href: p.href_custom || `/program#${p.slug}`,
  external: !!p.href_custom && !!p.href_external,
}));

const { results: lainnya } = await db
  .prepare(
    "SELECT nama, slug, kategori, foto FROM program WHERE status = 1 AND unggulan = 0 ORDER BY urutan ASC, id ASC",
  )
  .all<{ nama: string; slug: string; kategori: string; foto: string | null }>();
---
<Layout title="Program Kami — Yasuki">
  <section class="relative pt-24 pb-16 px-6 text-center overflow-hidden">
    <img src="/images/program/pertanian/petani-panen.jpg" alt="Program Yasuki" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-blue-950/85"></div>
    <Breadcrumb items={[{ label: "Beranda", href: "/" }, { label: "Program" }]} />
    <div class="relative z-10 mt-6">
      <p class="text-amber-400 font-medium text-sm uppercase tracking-wide mb-2">Program Kami</p>
      <h1 class="text-3xl md:text-5xl font-bold text-white mb-4">9 Jalan Kebaikan Yasuki</h1>
      <p class="text-blue-100 max-w-xl mx-auto">
        Dari santunan harian hingga pembangunan jangka panjang — setiap program adalah ikhtiar kami untuk terus peduli tiada henti.
      </p>
    </div>
  </section>

  <!-- Program Unggulan -->
  <section class="px-6 py-20 bg-white">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl font-bold text-blue-950 mb-2">Program Unggulan Yayasan</h2>
        <p class="text-slate-500">Pilar utama gerakan sosial dan pemberdayaan Yasuki</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {unggulan.map((p) => (
          <div id={p.slug} class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm flex flex-col scroll-mt-24">
            <div class="h-48 relative">
              {p.foto ? (
                <img src={p.foto} alt={p.nama} class="w-full h-full object-cover" />
              ) : (
                <div class="w-full h-full bg-gradient-to-br from-blue-900 to-blue-950" />
              )}
            </div>
            <div class="p-5 flex flex-col flex-1">
              <span class="inline-block bg-amber-50 text-amber-700 text-xs font-medium px-3 py-1 rounded-full mb-3 w-fit">
                {p.kategori}
              </span>
              <h3 class="text-blue-950 font-semibold text-lg mb-2">{p.nama}</h3>
              <p class="text-slate-600 text-sm mb-5 flex-1">{p.deskripsi}</p>
              <a
                href={p.href}
                target={p.external ? "_blank" : undefined}
                class="inline-block text-center bg-blue-900 text-white text-sm font-medium px-4 py-2.5 rounded-lg hover:bg-blue-800 transition"
              >
                Lihat Detail & Progres
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Program Lainnya -->
  <section class="px-6 py-20 bg-blue-50 bg-[radial-gradient(circle,rgba(30,58,138,0.12)_1px,transparent_1px)] bg-[length:22px_22px]">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl font-bold text-blue-950 mb-2">Program Lainnya</h2>
        <p class="text-slate-500">Kegiatan rutin Yasuki — update terbaru dapat dilihat di halaman Berita</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {lainnya.map((p) => (
          <div id={p.slug} class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm scroll-mt-24">
            <div class="h-28 bg-slate-100">
              {p.foto && <img src={p.foto} alt={p.nama} class="w-full h-full object-cover" />}
            </div>
            <div class="p-3 text-center">
              <span class="inline-block bg-amber-50 text-amber-700 text-[10px] font-medium px-2 py-0.5 rounded-full mb-1.5">
                {p.kategori}
              </span>
              <h3 class="text-blue-950 font-semibold text-sm">{p.nama}</h3>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Penutup -->
  <section class="px-6 py-16 bg-gradient-to-br from-amber-400 to-amber-500 text-center">
    <h2 class="text-xl md:text-2xl font-bold text-slate-900 mb-3">Tertarik Mendukung Salah Satu Program?</h2>
    <p class="text-slate-800 max-w-md mx-auto mb-6">
      Donasi kamu, sekecil apapun, langsung berdampak pada program-program di atas.
    </p>
    <a href="/donasi" class="inline-block bg-slate-900 text-white px-8 py-3 rounded-lg font-semibold hover:bg-slate-800 transition">
      Donasi Sekarang
    </a>
  </section>
</Layout>
