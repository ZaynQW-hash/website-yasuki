---
import "../styles/global.css";
import type { SessionPayload } from "../lib/auth";
import { bolehAksesModul } from "../lib/auth";

interface Props {
  title: string;
  admin?: SessionPayload;
}

const { title, admin } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  {
    href: "/admin",
    label: "Dashboard",
    icon: "M11.47 3.84a.75.75 0 011.06 0l8.69 8.69a.75.75 0 101.06-1.06l-8.689-8.69a2.25 2.25 0 00-3.182 0l-8.69 8.69a.75.75 0 001.061 1.06l8.69-8.69z M12 5.432l8.159 8.159c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 01-.75-.75v-4.5a.75.75 0 00-.75-.75h-3a.75.75 0 00-.75.75V21a.75.75 0 01-.75.75H5.625a1.875 1.875 0 01-1.875-1.875v-6.198a2.29 2.29 0 00.091-.086L12 5.43z",
    modul: null,
  },
  {
    href: "/admin/donasi",
    label: "Donasi",
    icon: "M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
    modul: "donasi",
  },
  {
    href: "/admin/berita",
    label: "Berita",
    icon: "M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m6.75 12H15a2.25 2.25 0 00-2.25 2.25v6.75m0-6.75V6.75m0 12l3-3m-3 3l-3-3M8.25 4.5H5.625c-.621 0-1.125.504-1.125 1.125v13.5c0 .621.504 1.125 1.125 1.125h5.25",
    modul: "berita",
  },
  {
    href: "/admin/program",
    label: "Program",
    icon: "M9 4.5v15m6-15v15m-10.875 0h15.75c.621 0 1.125-.504 1.125-1.125V5.625c0-.621-.504-1.125-1.125-1.125H4.125C3.504 4.5 3 5.004 3 5.625v12.75c0 .621.504 1.125 1.125 1.125z",
    modul: "program",
  },
  {
    href: "/admin/galeri",
    label: "Galeri",
    icon: "M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z",
    modul: "galeri",
  },
  {
    href: "/admin/pengguna",
    label: "Pengguna",
    icon: "M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z",
    modul: "pengguna",
  },
];

const visibleNavItems = navItems.filter((item) => !item.modul || (admin && bolehAksesModul(admin, item.modul)));

function isNavActive(href: string): boolean {
  // Dashboard (/admin) cuma aktif kalau BENERAN lagi di /admin, bukan cuma diawali /admin/
  if (href === "/admin") return currentPath === "/admin";
  return currentPath === href || currentPath.startsWith(href + "/");
}
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-100 font-sans antialiased text-sm" data-can-access-donasi={admin && bolehAksesModul(admin, "donasi") ? "1" : "0"}>
    <div class="min-h-screen md:flex">
      <!-- Sidebar (desktop) -->
      <aside class="hidden md:flex md:flex-col md:w-64 md:fixed md:inset-y-0 bg-blue-950 text-white">
        <div class="flex items-center gap-2 px-6 py-5 border-b border-white/10">
          <img src="/images/logo.png" alt="Yasuki" class="h-8 w-8 rounded-full" />
          <div>
            <p class="font-semibold text-sm leading-tight">Yasuki</p>
            <p class="text-xs text-blue-300 leading-tight">Dashboard Admin</p>
          </div>
        </div>

        <nav class="flex-1 px-3 py-4 space-y-1">
          {
            visibleNavItems.map((item) => {
              const isActive = isNavActive(item.href);
              return (
                <a
                  href={item.href}
                  class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${
                    isActive ? "bg-blue-800 text-white" : "text-blue-200 hover:bg-blue-900 hover:text-white"
                  }`}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-5 h-5 flex-shrink-0">
                    <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                  </svg>
                  <span class="flex-1">{item.label}</span>
                  {item.modul === "donasi" && (
                    <span class="donasi-notif-badge hidden min-w-5 h-5 px-1.5 rounded-full bg-amber-400 text-blue-950 text-[10px] font-bold items-center justify-center" aria-label="Donasi menunggu verifikasi"></span>
                  )}
                </a>
              );
            })
          }
        </nav>

        <div class="px-4 py-4 border-t border-white/10">
          <p class="text-xs text-blue-300 mb-2 truncate">
            {admin?.nama} <span class="text-blue-400">· {admin?.role}</span>
          </p>
          <form action="/api/admin/logout" method="POST">
            <button
              type="submit"
              class="w-full flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-red-300 hover:bg-red-950/60 hover:text-red-200 transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
              </svg>
              Keluar
            </button>
          </form>
        </div>
      </aside>

      <!-- Topbar (mobile) -->
      <header class="md:hidden sticky top-0 z-10 bg-blue-950 text-white px-4 py-3 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <img src="/images/logo.png" alt="Yasuki" class="h-7 w-7 rounded-full" />
          <span class="font-semibold text-sm">Dashboard Admin</span>
        </div>
        <form action="/api/admin/logout" method="POST">
          <button type="submit" class="text-xs text-red-300">Keluar</button>
        </form>
      </header>

      <!-- Nav mobile (baris menu di bawah topbar) -->
      <nav class="md:hidden flex bg-blue-900 text-white text-sm overflow-x-auto">
        {
          visibleNavItems.map((item) => {
            const isActive = isNavActive(item.href);
            return (
              <a href={item.href} class={`flex-1 text-center py-2.5 whitespace-nowrap px-3 ${isActive ? "bg-blue-800 font-medium" : "text-blue-200"}`}>
                <span>{item.label}</span>
                {item.modul === "donasi" && (
                  <span class="donasi-notif-badge hidden ml-1 min-w-5 h-5 px-1.5 rounded-full bg-amber-400 text-blue-950 text-[10px] font-bold items-center justify-center align-middle" aria-label="Donasi menunggu verifikasi"></span>
                )}
              </a>
            );
          })
        }
      </nav>

      <!-- Konten -->
      <div class="flex-1 min-w-0 md:ml-64">
        <main class="p-4 md:p-8">
          <div id="admin-donasi-notification" class="hidden max-w-7xl mx-auto mb-4">
            <a href="/admin/donasi?status=pending" class="flex items-center gap-3 bg-amber-50 border border-amber-200 rounded-xl px-4 py-3 text-amber-900 hover:bg-amber-100 transition">
              <span class="text-lg" aria-hidden="true">🔔</span>
              <span class="text-sm font-medium" id="admin-donasi-notification-text">Ada donasi baru yang menunggu verifikasi.</span>
              <span class="ml-auto text-xs font-semibold">Lihat →</span>
            </a>
          </div>
          <slot />
        </main>
      </div>
    </div>
    <script>
    const canAccessDonasi = document.body.dataset.canAccessDonasi === '1';
    const notifKey = 'yasuki_admin_latest_pending_donation_id';
    const notifBadges = Array.from(document.querySelectorAll('.donasi-notif-badge')) as HTMLElement[];
    const notifArea = document.getElementById('admin-donasi-notification') as HTMLDivElement | null;
    const notifText = document.getElementById('admin-donasi-notification-text') as HTMLElement | null;

    function updateDonationNotification(count: number) {
      notifBadges.forEach((badge) => {
        if (count > 0) {
          badge.textContent = count > 99 ? '99+' : String(count);
          badge.classList.remove('hidden');
          badge.classList.add('inline-flex');
        } else {
          badge.textContent = '';
          badge.classList.add('hidden');
          badge.classList.remove('inline-flex');
        }
      });

      if (notifArea && notifText) {
        if (count > 0) {
          notifText.textContent = count === 1
            ? 'Ada 1 donasi yang menunggu verifikasi.'
            : `Ada ${count} donasi yang menunggu verifikasi.`;
          notifArea.classList.remove('hidden');
        } else {
          notifArea.classList.add('hidden');
        }
      }
    }

    function showNewDonationToast(count: number) {
      const old = document.getElementById('yasuki-donation-toast');
      old?.remove();

      const toast = document.createElement('div');
      toast.id = 'yasuki-donation-toast';
      toast.className = 'fixed right-4 bottom-4 z-50 w-[min(360px,calc(100vw-2rem))] bg-white border border-amber-200 shadow-xl rounded-xl p-4';
      toast.innerHTML = `
        <div class="flex items-start gap-3">
          <div class="text-xl" aria-hidden="true">🔔</div>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-semibold text-slate-800">Ada donasi baru</p>
            <p class="text-xs text-slate-500 mt-1">${count === 1 ? '1 donasi' : `${count} donasi`} menunggu verifikasi.</p>
            <a href="/admin/donasi?status=pending" class="inline-block mt-2 text-xs font-semibold text-blue-700 hover:underline">Buka Kelola Donasi →</a>
          </div>
          <button type="button" aria-label="Tutup" class="text-slate-400 hover:text-slate-600 text-lg leading-none">×</button>
        </div>`;

      toast.querySelector('button')?.addEventListener('click', () => toast.remove());
      document.body.appendChild(toast);
      window.setTimeout(() => toast.remove(), 8000);
    }

    async function refreshDonationNotification(showToast = true) {
      if (!canAccessDonasi) return;

      try {
        const res = await fetch('/api/admin/donasi/pending-count', { cache: 'no-store' });
        if (!res.ok) return;
        const data = await res.json();
        const count = Number(data.jumlah || 0);
        const latestId = data.latest_id == null ? null : Number(data.latest_id);
        updateDonationNotification(count);

        if (latestId !== null) {
          const previousLatestId = Number(localStorage.getItem(notifKey) || '0');
          if (showToast && previousLatestId > 0 && latestId > previousLatestId) {
            showNewDonationToast(count);
          }
          localStorage.setItem(notifKey, String(latestId));
        }
      } catch {
        // Notifikasi bersifat tambahan; jangan ganggu halaman admin kalau endpoint gagal.
      }
    }

    if (canAccessDonasi) {
      refreshDonationNotification(false);
      window.setInterval(() => refreshDonationNotification(true), 30000);
    }
  </script>
</body>
</html>
